# Copy this file to `.env` (same directory) and fill in your API keys.
# The .env file is listed in .gitignore and will not be committed.

# OpenAI API key (used by the two GPT-5 collection notebooks)
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-REPLACE_WITH_YOUR_OPENAI_KEY

# Google Gemini API key (used by the Gemini 3 Flash collection notebook)
# Get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=REPLACE_WITH_YOUR_GOOGLE_KEY
